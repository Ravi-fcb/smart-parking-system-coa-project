call ReadDur
pop bx
mov dx,offset msg_2w
call PrintStr
mov dx,offset msg_parked
call PrintStr
mov ax,bx
inc ax
call PrintDec
jmp MAIN_LOOP
FWHEELER:call Find4WSlot
jc FULL
mov byte ptr [slot_status+bx],1
mov byte ptr [slot_type+bx],2
inc byte ptr [count]
inc byte ptr [c]
push bx
call ReadDur
pop bx
mov dx,offset msg_4w
call PrintStr
mov dx,offset msg_parked
call PrintStr
mov ax,bx
inc ax
call PrintDec
jmp MAIN_LOOP
EWHEELER:call Find8WSlot
jc FULL
mov byte ptr [slot_status+bx],1
mov byte ptr [slot_type+bx],3
inc byte ptr [count]
inc byte ptr [b]
push bx
call ReadDur
pop bx
mov dx,offset msg_8w
call PrintStr
mov dx,offset msg_parked
call PrintStr
mov ax,bx
inc ax
call PrintDec
jmp MAIN_LOOP
FULL:mov dx,offset msg_full
call PrintStr
jmp MAIN_LOOP
RECORD:mov dx,offset msg_total
call PrintStr
mov ax,word ptr [amount]
call PrintDec
call PrintCRLF
mov dx,offset msg_count
call PrintStr
