mov al,[capacity]
xor ah,ah
mov bl,10
mul bl
mov bl,25
div bl
add al,[tw_end]
mov byte ptr [fw_end],al
mov al,[fw_end]
inc al
mov byte ptr [ew_start],al
MAIN_LOOP:call PrintCRLF
mov dx,offset menu
call PrintStr
call ReadKey
mov bl,al
call PrintCRLF
cmp bl,'1'
je TWHEELER
cmp bl,'2'
je FWHEELER
cmp bl,'3'
je EWHEELER
cmp bl,'4'
je RECORD
cmp bl,'5'
je RESET_REC
cmp bl,'6'
je LEAVING
cmp bl,'7'
je EXIT_PROGRAM
mov dx,offset msg_wrong
call PrintStr
jmp MAIN_LOOP
TWHEELER:call Find2WSlot
jc FULL
mov byte ptr [slot_status+bx],1
mov byte ptr [slot_type+bx],1
inc byte ptr [count]
inc byte ptr [r]
