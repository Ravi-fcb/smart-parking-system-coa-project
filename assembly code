mov dx,offset msg_8w
call PrintStr
pop si
pop cx
SS8:push cx
push si
call PrintCRLF
pop si
pop cx
inc si
jmp SS1
SS9:pop si
pop dx
pop cx
pop bx
pop ax
ret
main proc
mov ax,@data
mov ds,ax
GET_CAP:mov dx,offset msg_capacity
call PrintStr
call ReadTwoDigit
call PrintCRLF
cmp al,10
jb GET_CAP
cmp al,99
ja GET_CAP
mov byte ptr [capacity],al
mov bl,al
xor bh,bh
mov ax,bx
mov bl,10
mul bl
mov bl,25
div bl
mov byte ptr [tw_end],al
mov al,[tw_end]
