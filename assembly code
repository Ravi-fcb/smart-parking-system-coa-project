call PrintCRLF
cmp al,'1'
je RT2
cmp al,'2'
je RT3
mov dx,offset msg_wrong
call PrintStr
call PrintCRLF
jmp RT1
RT2:mov byte ptr [slot_dur_type+bx],1
mov dx,offset msg_days
call PrintStr
call ReadDigit
call PrintCRLF
cmp al,1
jb RT2
cmp al,9
ja RT2
mov byte ptr [slot_dur+bx],al
jmp RT9
RT3:mov byte ptr [slot_dur_type+bx],2
mov dx,offset msg_hours
call PrintStr
call ReadDigit
call PrintCRLF
cmp al,1
jb RT3
cmp al,9
ja RT3
mov byte ptr [slot_dur+bx],al
RT9:pop dx
pop bx
pop ax
ret
ShowSlots:
push ax
push bx
push cx
push dx
push si
