ret
ReadDigit endp
ReadTwoDigit proc
push bx
push dx
call ReadDigit
mov bl,al
mov ah,7
int 21h
cmp al,13
je RTD_S
cmp al,10
je RTD_S
mov dl,al
mov ah,2
int 21h
cmp al,'0'
jb RTD_S
cmp al,'9'
ja RTD_S
sub al,'0'
mov cl,al
mov al,10
mul bl
add al,cl
pop dx
pop bx
ret
RTD_S:mov al,bl
pop dx
pop bx
ret
ReadTwoDigit endp
Find2WSlot:
push ax
push cx
mov cl,[tw_end]
xor ch,ch
xor bx,bx
F2W1:cmp bl,cl
jae F2WN
mov al,[slot_status+bx]
cmp al,0
je F2WF
inc bx
jmp F2W1
F2WF:pop cx
pop ax
clc
ret
F2WN:pop cx
pop ax
stc
ret
Find4WSlot:
push ax
push cx
push dx
mov bl,[fw_start]
dec bl
mov cl,[fw_end]
F4W1:cmp bl,cl
jae F4W2
mov al,[slot_status+bx]
cmp al,0
je F4WF
inc bx
jmp F4W1
F4W2:push bx
mov dx,offset msg_overflow
call PrintStr
pop bx
mov bl,[ew_start]
dec bl
mov cl,[capacity]
F4W3:cmp bl,cl
jae F4WN
mov al,[slot_status+bx]
cmp al,0
je F4WF
inc bx
