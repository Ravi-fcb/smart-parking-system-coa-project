jae F8WN
mov al,[slot_status+bx]
cmp al,0
je F8WF
inc bx
jmp F8W1
F8WF:pop cx
pop ax
clc
ret
F8WN:pop cx
pop ax
stc
ret
ReadDur:
push ax
push bx
push dx
mov dx,offset msg_dur_type
call PrintStr
