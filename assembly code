ret
PrintDec endp
ReadKey proc
push dx
RK1:mov ah,7
int 21h
cmp al,13
je RK1
cmp al,10
je RK1
mov dl,al
mov ah,2
int 21h
pop dx
ret
ReadKey endp
ReadDigit proc
push dx
RD1:call ReadKey
